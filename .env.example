# Copy this file to .env and fill in the MySQL database you created.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=notes
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=porter_notes

PORT=3000

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set to true when a reverse proxy forwards the original client address.
TRUST_PROXY=false
