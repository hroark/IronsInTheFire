# This is a file for the local npm server, not a folder.
# The hosted notes page does not read it. Put those settings in notes/config.php.
# Copy this file to .env only when you run npm start on your own computer.
# If a password contains #, wrap the value in single quotes.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=notes
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=porter_notes

PORT=3000

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set to true when a reverse proxy forwards the original client address.
TRUST_PROXY=false
