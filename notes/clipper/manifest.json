{
  "manifest_version": 3,
  "name": "Save to Inbox",
  "version": "1.0.0",
  "description": "Save the current page URL, title, and selected text to your notes Inbox.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Save to Inbox"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
